{
  "name": "design",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "lint": "eslint src scripts tests worker vite.config.mjs eslint.config.js --max-warnings 0",
    "format": "prettier --write . --ignore-unknown --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-unknown --ignore-path .prettierignore",
    "test": "node --test tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "pnpm": "11.19.0",
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/x": "^2.9.0",
    "@vitejs/plugin-react": "5.0.4",
    "antd": "^6.6.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "eslint": "9.39.4",
    "eslint-plugin-react": "7.37.5",
    "globals": "16.5.0",
    "prettier": "3.9.9"
  }
}
